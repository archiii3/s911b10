# devpulse.py
import json
import os
from datetime import datetime

DATA_FILE = "devpulse.json"


def load_data():
    if not os.path.exists(DATA_FILE):
        return []

    with open(DATA_FILE, "r", encoding="utf-8") as file:
        return json.load(file)


def save_data(data):
    with open(DATA_FILE, "w", encoding="utf-8") as file:
        json.dump(data, file, indent=2)


def add_session(project, minutes, note=""):
    data = load_data()

    session = {
        "project": project,
        "minutes": minutes,
        "note": note,
        "date": datetime.now().strftime("%Y-%m-%d %H:%M")
    }

    data.append(session)
    save_data(data)

    print(f"✓ Session added: {project} ({minutes} min)")


def show_stats():
    data = load_data()

    if not data:
        print("No sessions recorded yet.")
        return

    total_minutes = sum(item["minutes"] for item in data)

    projects = {}
    for item in data:
        project = item["project"]
        projects[project] = projects.get(project, 0) + item["minutes"]

    print("\n=== DevPulse Stats ===")
    print(f"Total time: {total_minutes} minutes")
    print(f"Sessions: {len(data)}")

    print("\nBy project:")
    for project, minutes in sorted(
        projects.items(),
        key=lambda x: x[1],
        reverse=True
    ):
        print(f"  {project}: {minutes} min")


def show_history():
    data = load_data()

    if not data:
        print("No history available.")
        return

    print("\n=== Session History ===")

    for item in reversed(data):
        print(
            f"[{item['date']}] "
            f"{item['project']} - "
            f"{item['minutes']} min"
        )

        if item["note"]:
            print(f"  Note: {item['note']}")


def main():
    print("DevPulse - Developer Productivity Tracker")
    print("-----------------------------------------")

    while True:
        print("\n1. Add session")
        print("2. View statistics")
        print("3. View history")
        print("4. Exit")

        choice = input("\nSelect an option: ").strip()

        if choice == "1":
            project = input("Project name: ").strip()

            try:
                minutes = int(input("Minutes worked: "))
            except ValueError:
                print("Please enter a valid number.")
                continue

            note = input("Note (optional): ").strip()

            add_session(project, minutes, note)

        elif choice == "2":
            show_stats()

        elif choice == "3":
            show_history()

        elif choice == "4":
            print("Keep building.")
            break

        else:
            print("Invalid option.")


if __name__ == "__main__":
    main()
